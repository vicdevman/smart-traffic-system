# ---------------------------------------------------------------------------
# SMART TRAFFIC MANAGEMENT SYSTEM (STMS) - Environment Configuration
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` for local development:
#     cp .env.example .env.local          (macOS / Linux)
#     copy .env.example .env.local        (Windows CMD)
#     Copy-Item .env.example .env.local   (Windows PowerShell)
#
# On Vercel, add each of these under:
#     Project -> Settings -> Environment Variables
# ---------------------------------------------------------------------------


# ===========================================================================
# 1. DATABASE  (optional - the app runs without it in DEMO MODE)
# ===========================================================================
# MongoDB Atlas connection string. Get a free cluster at
# https://www.mongodb.com/cloud/atlas  ->  Connect  ->  Drivers  ->  Node.js
#
# Format:
#   mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
#
# NOTE: if your password contains @ : / ? # [ ] % you MUST percent-encode it.
#       Example: "p@ss:word" becomes "p%40ss%3Aword"
#
# If MONGODB_URI is left empty or unset, the system automatically falls back to
# an in-memory store so the dashboard still works end-to-end. Nothing is
# persisted between server restarts in that mode.
MONGODB_URI=

# Name of the database to use inside the cluster.
MONGODB_DB=smart_traffic


# ===========================================================================
# 2. EDGE / DEVICE AUTHENTICATION
# ===========================================================================
# Shared secret presented by edge controllers (Raspberry Pi units, or the
# bundled virtual edge simulator) in the `x-device-key` header when they POST
# telemetry to /api/telemetry.
#
# Generate a strong value, e.g.:
#     node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
#
# If left empty, telemetry ingest is OPEN (fine for a local demo, not for
# production). The dashboard's built-in simulator uses this automatically.
DEVICE_API_KEY=

# ===========================================================================
# 3. OPERATOR (TRAFFIC WARDEN) ACCESS
# ===========================================================================
# Passcode required before an operator can issue a manual signal override or
# force an emergency preemption from the dashboard control panel.
# Leave empty to disable the passcode gate (demo/presentation mode).
OPERATOR_PASSCODE=traffic2026

# ===========================================================================
# 4. PUBLIC RUNTIME SETTINGS (safe to expose to the browser)
# ===========================================================================
# How often (REAL milliseconds) the in-browser edge controller uploads a
# telemetry batch to the cloud API. Independent of the simulation speed
# multiplier, so raising the speed does not flood the ingest endpoint.
NEXT_PUBLIC_TELEMETRY_INTERVAL_MS=5000

# How often (real milliseconds) the dashboard polls the cloud for pending
# operator override commands.
NEXT_PUBLIC_COMMAND_POLL_MS=4000

# Default intersection loaded by the dashboard on first visit.
NEXT_PUBLIC_DEFAULT_INTERSECTION=INT-001

# Set to "false" to hide the demo-mode banner during a live presentation.
NEXT_PUBLIC_SHOW_DEMO_BANNER=true
